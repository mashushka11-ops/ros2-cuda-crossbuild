ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

ARG CUDA_ARCH=87

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# 1. Обновление GPG-ключа ROS2, системные библиотеки, middleware и сборщики интерфейсов
RUN apt-get update || true && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" > /etc/apt/sources.list.d/ros2.list \
    && ([ -f /sbin/ldconfig.real ] && dpkg-divert --local --rename --add /sbin/ldconfig.real && ln -s /bin/true /sbin/ldconfig.real || true) \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    pkg-config \
    libpcap-dev \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rmw-fastrtps-cpp \
    ros-humble-rosidl-default-generators \
    ros-humble-rosidl-default-runtime \
    ros-humble-rosidl-adapter \
    ros-humble-common-interfaces \
    ros-humble-tf2-ros \
    ros-humble-pcl-conversions \
    ros-humble-pcl-ros \
    && ([ -L /sbin/ldconfig.real ] && rm /sbin/ldconfig.real && dpkg-divert --local --rename --remove /sbin/ldconfig.real && /sbin/ldconfig || true) \
    && rm -rf /var/lib/apt/lists/*

# 2. Проверка и установка Livox-SDK2
RUN if [ ! -f /usr/local/lib/liblivox_lidar_sdk_shared.so ]; then \
      find /usr/local/lib64 -name "*livox*" -exec cp -r {} /usr/local/lib/ \; 2>/dev/null || true; \
    fi && \
    if [ ! -f /usr/local/lib/liblivox_lidar_sdk_shared.so ]; then \
      git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 && \
      cd /tmp/Livox-SDK2 && mkdir build && cd build && \
      cmake -DCMAKE_BUILD_TYPE=Release .. && make -j$(nproc) && make install && \
      cp -r /usr/local/lib64/* /usr/local/lib/ 2>/dev/null || true && \
      rm -rf /tmp/Livox-SDK2; \
    fi && ldconfig

# 3. Сборка livox_ros_driver2 через официальный build.sh humble и экспорт в ROS2
WORKDIR /workspace/livox_ws/src
RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git && \
    cd livox_ros_driver2 && \
    source /opt/ros/humble/setup.bash && \
    ./build.sh humble && \
    cp -r /workspace/livox_ws/install/livox_ros_driver2/* /opt/ros/humble/ && \
    rm -rf /workspace/livox_ws

# 4. Клонирование и сборка FAST_LIO под ROS2 (с подмодулем ikd-Tree)
WORKDIR /workspace/ros2_ws/src
RUN git clone --recurse-submodules --depth 1 https://github.com/Ericsii/FAST_LIO_ROS2.git fast_lio

WORKDIR /workspace/ros2_ws
RUN source /opt/ros/humble/setup.bash && \
    colcon build --packages-select fast_lio \
      --cmake-args \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
      --parallel-workers 1

# 5. Проброс окружения в контейнер
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc && \
    echo "source /workspace/ros2_ws/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
