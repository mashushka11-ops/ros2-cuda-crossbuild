ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

ARG REPO_URL=https://github.com/Ericsii/FAST_LIO_ROS2.git
ARG BRANCH=main
ARG CUDA_ARCH=87

ENV DEBIAN_FRONTEND=noninteractive

# 1. Установка заголовков Python и стандартных пакетов ROS2
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    ros-humble-common-interfaces \
    ros-humble-tf2-ros \
    ros-humble-pcl-conversions \
    ros-humble-pcl-ros \
    && rm -rf /var/lib/apt/lists/*

# 2. Подготовка рабочей области и исходников
WORKDIR /workspace/ros2_ws/src

RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git && \
    git clone -b ${BRANCH} --depth 1 ${REPO_URL} fast_lio

# 3. Единая сборка рабочей области (colcon сам связывает зависимости)
WORKDIR /workspace/ros2_ws

RUN source /opt/ros/humble/setup.bash && \
    colcon build \
    --cmake-args \
      -DROS_EDITION=ROS2 \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
    --parallel-workers 1

# 4. Настройка окружения
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc && \
    echo "source /workspace/ros2_ws/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
