ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

ARG REPO_URL=https://github.com/Ericsii/FAST_LIO_ROS2.git
ARG BRANCH=main
ARG CUDA_ARCH=87

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

# 1. Системные библиотеки, утилиты и генераторы интерфейсов
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    pkg-config \
    libpcap-dev \
    ros-humble-rosidl-default-generators \
    ros-humble-rosidl-default-runtime \
    ros-humble-rosidl-adapter \
    ros-humble-common-interfaces \
    ros-humble-tf2-ros \
    ros-humble-pcl-conversions \
    ros-humble-pcl-ros \
    && rm -rf /var/lib/apt/lists/*

# 2. Гарантия наличия Livox-SDK2 в системных путях библиотеки
RUN if [ ! -f /usr/local/lib/liblivox_lidar_sdk_shared.so ]; then \
      find /usr/local/lib64 -name "*livox*" -exec cp -r {} /usr/local/lib/ \; 2>/dev/null || true; \
    fi && \
    if [ ! -f /usr/local/lib/liblivox_lidar_sdk_shared.so ]; then \
      git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 && \
      cd /tmp/Livox-SDK2 && mkdir build && cd build && \
      cmake -DCMAKE_BUILD_TYPE=Release .. && make -j$(nproc) && make install && \
      cp -r /usr/local/lib64/* /usr/local/lib/ 2>/dev/null || true && \
      rm -rf /tmp/Livox-SDK2; \
    fi && ldconfig

# 3. Подготовка рабочей области и исходников
WORKDIR /workspace/ros2_ws/src

RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git && \
    git clone -b ${BRANCH} --depth 1 ${REPO_URL} fast_lio

# 4. Сборка livox_ros_driver2 через скрипт build.sh humble
WORKDIR /workspace/ros2_ws/src/livox_ros_driver2
RUN source /opt/ros/humble/setup.bash && \
    ./build.sh humble

# 5. Сборка FAST-LIO
WORKDIR /workspace/ros2_ws
RUN source /opt/ros/humble/setup.bash && \
    source /workspace/ros2_ws/src/livox_ros_driver2/install/setup.bash && \
    colcon build --packages-select fast_lio \
      --cmake-args \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
        -DCMAKE_PREFIX_PATH="/workspace/ros2_ws/src/livox_ros_driver2/install/livox_ros_driver2;/usr/local;/opt/ros/humble" \
      --parallel-workers 1

# 6. Настройка окружения контейнера
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc && \
    echo "source /workspace/ros2_ws/src/livox_ros_driver2/install/setup.bash" >> /root/.bashrc && \
    echo "source /workspace/ros2_ws/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
