# Аргумент базового образа (x86 или jetson)
ARG BASE_IMAGE=ros2-cuda-base:x86
FROM ${BASE_IMAGE}

# Ветка и репозиторий порта под ROS2 Humble
ARG REPO_URL="https://github.com/flynneva/FAST_LIO_ROS2.git"
ARG REPO_BRANCH="main"
ARG CUDA_ARCH="86"

ENV DEBIAN_FRONTEND=noninteractive
ENV TORCH_CUDA_ARCH_LIST="${CUDA_ARCH}"

# Системные библиотеки PCL, Eigen и ROS2-сообщения
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcl-dev \
    libeigen3-dev \
    ros-humble-pcl-conversions \
    ros-humble-pcl-msgs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/ros2_ws/src

# Клонируем исходный код ROS2-пакета
RUN git clone --branch ${REPO_BRANCH} --depth 1 ${REPO_URL} || \
    git clone --depth 1 ${REPO_URL}

WORKDIR /workspace/ros2_ws

# Установка зависимостей пакета
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    rosdep install --from-paths src --ignore-src -r -y || true"

# Сборка пакета через colcon
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    colcon build --symlink-install --cmake-args \
    -DCMAKE_BUILD_TYPE=Release"

# Автоподключение пакета в окружение
RUN echo "source /workspace/ros2_ws/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
