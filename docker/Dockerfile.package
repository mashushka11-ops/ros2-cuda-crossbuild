# Базовый образ с ROS2 и CUDA
ARG BASE_IMAGE=ros2-cuda-base:x86
FROM ${BASE_IMAGE}

ARG REPO_URL="https://github.com/flynneva/FAST_LIO_ROS2.git"
ARG REPO_BRANCH="main"
ARG CUDA_ARCH="86"

ENV DEBIAN_FRONTEND=noninteractive
ENV TORCH_CUDA_ARCH_LIST="${CUDA_ARCH}"

# 1. Библиотеки PCL, Eigen
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcl-dev \
    libeigen3-dev \
    ros-humble-pcl-conversions \
    ros-humble-pcl-msgs \
    ros-humble-perception-pcl \
    && rm -rf /var/lib/apt/lists/*

# 2. Сборка Livox-SDK2 в систему
WORKDIR /workspace
RUN git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git && \
    cd Livox-SDK2 && \
    mkdir build && cd build && \
    cmake .. && make -j2 && make install && \
    ldconfig && \
    cd /workspace && rm -rf Livox-SDK2

# 3. Воркспейс ROS2
WORKDIR /workspace/ros2_ws/src
RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git && \
    git clone --branch ${REPO_BRANCH} --depth 1 ${REPO_URL} || git clone --depth 1 ${REPO_URL}

WORKDIR /workspace/ros2_ws

# 4. Этап 1: сборка сообщений драйвера Livox
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    colcon build --packages-select livox_ros_driver2 --cmake-args -DROS_EDITION=ROS2 -DCMAKE_BUILD_TYPE=Release --parallel-workers 1"

# 5. Этап 2: подтягивание скомпилированных сообщений и сборка FAST-LIO
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    source /workspace/ros2_ws/install/setup.bash && \
    colcon build --packages-select fast_lio --cmake-args -DCMAKE_BUILD_TYPE=Release --parallel-workers 1"

# 6. Автосорсинг
RUN echo "source /workspace/ros2_ws/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]