# Базовый образ с ROS2 и CUDA
ARG BASE_IMAGE=ros2-cuda-base:x86
FROM ${BASE_IMAGE}

ARG REPO_URL="https://github.com/Ericsii/FAST_LIO_ROS2.git"
ARG REPO_BRANCH="main"
ARG CUDA_ARCH="86"

ENV DEBIAN_FRONTEND=noninteractive
ENV TORCH_CUDA_ARCH_LIST="${CUDA_ARCH}"

# 1. Системные зависимости ROS2, PCL и генераторы интерфейсов
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcl-dev \
    libeigen3-dev \
    ros-humble-pcl-conversions \
    ros-humble-pcl-msgs \
    ros-humble-perception-pcl \
    ros-humble-diagnostic-updater \
    ros-humble-rosidl-default-generators \
    ros-humble-rosidl-default-runtime \
    && rm -rf /var/lib/apt/lists/*

# 2. Сборка и системная установка Livox-SDK2
WORKDIR /workspace
RUN git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git && \
    cd Livox-SDK2 && \
    mkdir build && cd build && \
    cmake .. && make -j2 && make install && \
    ldconfig && \
    cd /workspace && rm -rf Livox-SDK2

# 3. Подготовка рабочего пространства ROS2
WORKDIR /workspace/ros2_ws/src

# Клонируем драйвер Livox и рабочий ROS2-репозиторий FAST_LIO_ROS2
RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git && \
    git clone --depth 1 https://github.com/Ericsii/FAST_LIO_ROS2.git

# 4. Сборка драйвера родным скриптом с точным указанием дистрибутива humble
WORKDIR /workspace/ros2_ws/src/livox_ros_driver2
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && ./build.sh humble"

# 5. Сборка пакета FAST_LIO_ROS2 поверх собранного драйвера
WORKDIR /workspace/ros2_ws
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    source install/setup.bash && \
    colcon build --packages-select fast_lio --cmake-args -DCMAKE_BUILD_TYPE=Release --parallel-workers 1"

# 6. Автосорсинг при старте контейнера
RUN echo "source /workspace/ros2_ws/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
