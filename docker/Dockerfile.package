# Аргумент базового образа (подставится автоматически: x86 или jetson)
ARG BASE_IMAGE=ros2-cuda-base:x86
FROM ${BASE_IMAGE}

# Аргументы для сборки любого ROS2-пакета
ARG REPO_URL="https://github.com/hku-mars/FAST_LIO.git"
ARG REPO_BRANCH="main"
ARG CUDA_ARCH="87"

ENV DEBIAN_FRONTEND=noninteractive
ENV TORCH_CUDA_ARCH_LIST="${CUDA_ARCH}"

# 1. Установка дополнительных библиотек для лидаров и математики (Eigen, PCL)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcl-dev \
    libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Создаем стандартный ROS2-воркспейс
WORKDIR /workspace/ros2_ws/src

# 3. Клонируем исходный код пакета
RUN git clone --branch ${REPO_BRANCH} --depth 1 ${REPO_URL} || \
    git clone --depth 1 ${REPO_URL}

# 4. Устанавливаем зависимости пакета через rosdep и компилируем
WORKDIR /workspace/ros2_ws

RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    rosdep install --from-paths src --ignore-src -r -y || true"

# Собираем пакет утилитой colcon с флагами архитектуры CUDA
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    colcon build --symlink-install --cmake-args \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH}"

# Автоматический сорсинг собранного пакета при старте контейнера
RUN echo "source /workspace/ros2_ws/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
