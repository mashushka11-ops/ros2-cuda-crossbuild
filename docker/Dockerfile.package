ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

ARG REPO_URL=https://github.com/Ericsii/FAST_LIO_ROS2.git
ARG BRANCH=main
ARG CUDA_ARCH=87

ENV DEBIAN_FRONTEND=noninteractive

# 1. Системные зависимости и генераторы сообщений ROS2
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    pkg-config \
    libpcap-dev \
    ros-humble-rosidl-default-generators \
    ros-humble-rosidl-default-runtime \
    ros-humble-rosidl-adapter \
    ros-humble-common-interfaces \
    ros-humble-tf2-ros \
    ros-humble-pcl-conversions \
    ros-humble-pcl-ros \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/*

# 2. Подготовка исходников и запуск скрипта адаптации Livox под ROS2
WORKDIR /workspace/ros2_ws/src

RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git && \
    git clone -b ${BRANCH} --depth 1 ${REPO_URL} fast_lio && \
    cd livox_ros_driver2 && \
    ./build.sh ros2

# 3. Сборка драйвера livox_ros_driver2 с явным указанием путей к Livox-SDK2
WORKDIR /workspace/ros2_ws

RUN source /opt/ros/humble/setup.bash && \
    colcon build --packages-select livox_ros_driver2 \
      --cmake-args \
        -DROS_EDITION=ROS2 \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="/usr/local;/opt/ros/humble" \
        -DCMAKE_LIBRARY_PATH="/usr/local/lib" \
      --parallel-workers 1

# 4. Сборка пакета FAST-LIO
RUN source /opt/ros/humble/setup.bash && \
    source /workspace/ros2_ws/install/setup.bash && \
    colcon build --packages-select fast_lio \
      --cmake-args \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
        -DCMAKE_PREFIX_PATH="/workspace/ros2_ws/install/livox_ros_driver2;/usr/local;/opt/ros/humble" \
      --parallel-workers 1

# 5. Настройка окружения контейнера
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc && \
    echo "source /workspace/ros2_ws/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
