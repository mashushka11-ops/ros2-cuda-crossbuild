FROM dustynv/ros:humble-ros-base-l4t-r36.2.0

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# 1. Системные зависимости с защитой от сбоя QEMU на триггере libc-bin
RUN [ -f /sbin/ldconfig.real ] && dpkg-divert --local --rename --add /sbin/ldconfig.real && ln -s /bin/true /sbin/ldconfig.real || true \
    && apt-get update && apt-get install -y --no-install-recommends \
    locales \
    curl \
    gnupg2 \
    lsb-release \
    build-essential \
    cmake \
    git \
    python3-pip \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/* \
    && [ -L /sbin/ldconfig.real ] && rm /sbin/ldconfig.real && dpkg-divert --local --rename --remove /sbin/ldconfig.real && /sbin/ldconfig || true

# 2. Сборка и установка Livox-SDK2
WORKDIR /tmp
RUN git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git && \
    cd Livox-SDK2 && \
    mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release .. && \
    make -j$(nproc) && \
    make install && \
    cp -r /usr/local/lib64/* /usr/local/lib/ 2>/dev/null || true && \
    ldconfig && \
    rm -rf /tmp/Livox-SDK2

WORKDIR /workspace

CMD ["/bin/bash"]
